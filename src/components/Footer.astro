---
import { SITE, AUTHOR } from '../consts';
import { withBase } from '../utils/url';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container inner">
    <p>© {year} {AUTHOR.name} · <span class="brand">{SITE.title}<span aria-hidden="true">.</span></span></p>
    <ul>
      <li><a href={withBase('/rss.xml')}>RSS</a></li>
      <li><a href={withBase('/sitemap-index.xml')}>Sitemap</a></li>
      <li><a href={withBase('/llms.txt')}>llms.txt</a></li>
    </ul>
  </div>
</footer>

<style>
  .site-footer { background: var(--black); color: var(--white); margin-top: 6rem; border-top: 4px solid var(--orange); }
  .inner { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 1rem; padding-block: 2rem; font-size: 0.9rem; }
  p { margin: 0; }
  .brand span { color: var(--orange); }
  ul { display: flex; gap: 1.25rem; list-style: none; margin: 0; padding: 0; }
  a { color: var(--white); }
  a:hover { color: var(--orange); }
</style>
