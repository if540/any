---
import ArticleList from '../../components/articles/ArticleList.astro';
import { getArticles } from '../../utils/content';
import { collectTags, pageCount, slicePage } from '../../utils/article-list';

const articles = await getArticles();
---
<ArticleList
  posts={slicePage(articles, 1)}
  total={articles.length}
  allCount={articles.length}
  tags={collectTags(articles)}
  page={1}
  pages={pageCount(articles.length)}
/>
