---
// Claude Skills 專題單元的首頁：Skills 撰寫指南，單頁應用（SPA）
// 有 JavaScript 時以網址 hash 切換章節（#load、#fields…）；沒有 JavaScript 時所有章節依序顯示，錨點照常可用。
import '../../styles/claude-skills.css';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { SERIES, AUTHORS } from '../../consts';
import { getArticles } from '../../utils/content';
import { absoluteUrl, withBase } from '../../utils/url';

const unit = SERIES['claude-skills'];
const posts = (await getArticles()).filter((p) => p.data.series === 'claude-skills');
const url = absoluteUrl(unit.href, Astro.site);
const home = absoluteUrl('/', Astro.site);
const published = new Date('2026-11-17');

const chapters = [
  { id: 'load', title: '怎麼被載入' },
  { id: 'fields', title: 'Frontmatter 欄位' },
  { id: 'description', title: '寫好 description' },
  { id: 'body', title: '內容與寫作原則' },
  { id: 'files', title: '附加檔案與 scripts' },
  { id: 'advanced', title: 'fork、參數、動態注入' },
  { id: 'examples', title: '完整範例' },
  { id: 'pitfalls', title: '常見錯誤與檢查' },
];
const pager = (id: string) => {
  const i = chapters.findIndex((c) => c.id === id);
  return { prev: chapters[i - 1], next: chapters[i + 1] };
};
// 每章底部的上一章／下一章（內容是固定的章節名稱，不含使用者輸入）
type Chapter = (typeof chapters)[number];
const pagerHtml = ({ prev, next }: { prev?: Chapter; next?: Chapter }) => `
  <nav class="cs-pager" aria-label="章節切換">
    ${prev ? `<a class="prev" href="#${prev.id}"><small>上一章</small>${prev.title}</a>` : '<span></span>'}
    ${next ? `<a class="next" href="#${next.id}"><small>下一章</small>${next.title}</a>` : ''}
  </nav>`;

const demoHtml = (d: Demo) => `
  <figure class="cs-demo" aria-labelledby="demo-${d.id}">
    <figcaption id="demo-${d.id}">${esc(d.title)}</figcaption>
    <div class="cs-demo-grid">
      <div class="cs-demo-step"><p class="cs-demo-label">① SKILL.md</p><pre><code>${esc(d.skill)}</code></pre></div>
      <div class="cs-demo-right">
        <div class="cs-demo-step"><p class="cs-demo-label">② 你輸入</p><pre class="cs-demo-input"><code>${esc(d.input)}</code></pre></div>
        <div class="cs-demo-step is-result"><p class="cs-demo-label">③ ${d.resultLabel ?? 'Claude 收到'}</p><pre><code>${hl(d.result)}</code></pre></div>
      </div>
    </div>
    ${d.note ? `<p class="cs-demo-note">${esc(d.note)}</p>` : ''}
  </figure>`;

// Frontmatter 欄位：表格與「欄位快搜」共用同一份資料（use、note 是固定的 HTML 片段）
const fields = [
  { names: ['name'], group: '觸發', use: '<code>/</code> 選單中的指令名', note: '預設取資料夾名；小寫英數與連字號，最多 64 字元，不可含 claude、anthropic' },
  { names: ['description'], group: '觸發', badge: '建議必填', use: '做什麼＋何時用', note: '觸發的唯一依據；規格上限 1,024 字元' },
  { names: ['when_to_use'], group: '觸發', cc: true, use: '補充觸發句型、範例請求', note: '接在 description 後，合計 1,536 字元後截斷' },
  { names: ['paths'], group: '觸發', cc: true, use: 'glob 限定觸發範圍', note: '只在處理符合的檔案時自動載入' },
  { names: ['disable-model-invocation'], group: '觸發', cc: true, use: '<code>true</code> 時只能手動 <code>/name</code>', note: '用在有副作用的流程：deploy、commit、發訊息' },
  { names: ['user-invocable'], group: '觸發', cc: true, use: '<code>false</code> 時只有 Claude 能用', note: '用在背景知識類 skill' },
  { names: ['allowed-tools'], group: '權限', use: '該回合免詢問即可使用的工具', note: '例 <code>Bash(git add *) Read</code>；只是預先授權，不限制其他工具' },
  { names: ['disallowed-tools'], group: '權限', cc: true, use: 'skill 執行期間移除的工具', note: '例如背景迴圈禁止 <code>AskUserQuestion</code>' },
  { names: ['hooks'], group: '權限', cc: true, use: 'skill 呼叫後註冊的 hooks', note: '必守規則放這裡比寫在內文可靠' },
  { names: ['context'], group: '執行', cc: true, use: '設 <code>fork</code> 在 subagent 中執行', note: 'subagent 看不到對話歷史' },
  { names: ['agent'], group: '執行', cc: true, use: 'fork 時用哪種 subagent', note: '<code>Explore</code>、<code>Plan</code>、<code>general-purpose</code>（預設）或 <code>.claude/agents/</code> 自訂' },
  { names: ['background'], group: '執行', cc: true, use: 'fork 時是否背景執行', note: '預設 <code>true</code>；設 <code>false</code> 會等結果，並保留完整工具集' },
  { names: ['model', 'effort'], group: '執行', cc: true, use: '該回合的模型與思考程度', note: 'fork 時改為設定 subagent' },
  { names: ['shell'], group: '執行', cc: true, use: '<code>bash</code> 或 <code>powershell</code>', note: '用於動態注入的指令' },
  { names: ['argument-hint'], group: '參數', cc: true, use: '自動完成時顯示的參數提示', note: '例 <code>[issue-number]</code>' },
  { names: ['arguments'], group: '參數', cc: true, use: '具名參數', note: '搭配 <code>$name</code> 佔位符' },
  { names: ['license', 'compatibility', 'metadata'], group: '描述性', use: '授權、環境需求、自訂資料', note: 'Claude Code 接受但不會作用' },
] as { names: string[]; group: string; use: string; note: string; cc?: boolean; badge?: string }[];
const fieldGroups = [...new Set(fields.map((f) => f.group))];
const stripTags = (html: string) => html.replace(/<[^>]+>/g, '');
// 給快搜用的純文字資料（JSON 放在頁面上，由 src/scripts/claude-skills.ts 讀取）
const searchIndex = fields.map((f) => ({
  id: `field-${f.names[0]}`,
  names: f.names,
  group: f.group,
  use: stripTags(f.use),
  note: stripTags(f.note),
  cc: Boolean(f.cc),
}));

// 第 06 章的範例：每個範例是「SKILL.md → 你輸入 → Claude 收到」。
// result 裡用 ⟦⟧ 包住被替換進去的值，畫面上會標成橘色。
type Demo = { id: string; title: string; skill: string; input: string; result: string; note?: string; resultLabel?: string };
const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const hl = (s: string) => esc(s).replace(/⟦([\s\S]*?)⟧/g, '<mark>$1</mark>');

const forkDemo: Demo = {
  id: 'fork',
  title: '把 PR 摘要交給 subagent 去做',
  skill: `---
name: pr-summary
description: Summarize changes in a pull request
context: fork
agent: Explore
allowed-tools: Bash(gh *)
---

## Pull request context
- PR diff: !\`gh pr diff\`
- Changed files: !\`gh pr diff --name-only\`

## Your task
Summarize this pull request in 3 bullet points,
then list risky changes with file names.`,
  input: '/pr-summary',
  resultLabel: '實際發生的事',
  result: `1. Claude Code 先執行 gh pr diff 等指令，把輸出填進內容
2. 開一個新的 ⟦Explore⟧ subagent，整份內容就是它的任務
   （它看不到你和 Claude 之前聊過什麼）
3. subagent 讀檔、整理，在背景跑完
4. 主對話只收到它回傳的⟦摘要⟧，diff 原文不會塞進主對話`,
};

const argDemos: Demo[] = [
  {
    id: 'all',
    title: '$ARGUMENTS：整串照貼',
    skill: `---
name: fix-issue
description: Fix a GitHub issue
disable-model-invocation: true
---

Fix GitHub issue $ARGUMENTS following our coding standards.`,
    input: '/fix-issue 123',
    result: 'Fix GitHub issue ⟦123⟧ following our coding standards.',
    note: '指令名稱後面打的所有文字，原封不動放進 $ARGUMENTS 的位置。',
  },
  {
    id: 'index',
    title: '$0、$1、$2：依位置拆開',
    skill: `---
name: migrate-component
description: Migrate a component from one language to another
---

Migrate the $0 component from $1 to $2.
Preserve all existing behavior and tests.`,
    input: '/migrate-component SearchBar JavaScript TypeScript',
    result: `Migrate the ⟦SearchBar⟧ component from ⟦JavaScript⟧ to ⟦TypeScript⟧.
Preserve all existing behavior and tests.`,
    note: '用空白切開，第一個是 $0（從 0 開始數）。$0 等於 $ARGUMENTS[0]，只是寫法比較短。',
  },
  {
    id: 'quote',
    title: '有空白的值：用引號包起來',
    skill: `---
name: greet
description: Write a greeting card
---

Write a card for $0. Tone: $1.`,
    input: '/greet "王小明 先生" formal',
    result: 'Write a card for ⟦王小明 先生⟧. Tone: ⟦formal⟧.',
    note: '沒加引號的話，「王小明」會變成 $0，「先生」變成 $1。',
  },
  {
    id: 'named',
    title: 'arguments：幫位置取名字',
    skill: `---
name: fix-on-branch
description: Fix an issue on a given branch
arguments: [issue, branch]
---

Check out $branch, then fix issue #$issue.`,
    input: '/fix-on-branch 123 hotfix/login',
    result: 'Check out ⟦hotfix/login⟧, then fix issue #⟦123⟧.',
    note: 'arguments 依順序對應位置：issue 是第 1 個、branch 是第 2 個。名字比 $0、$1 好讀，也不怕寫錯順序。',
  },
  {
    id: 'none',
    title: '沒寫任何佔位符：自動附在最後',
    skill: `---
name: explain
description: Explain a file in plain language
---

Explain what this file does for a new teammate.`,
    input: '/explain src/auth.ts',
    result: `Explain what this file does for a new teammate.

⟦ARGUMENTS: src/auth.ts⟧`,
    note: '內容裡沒有任何佔位符時，Claude Code 會在最後補一行 ARGUMENTS，所以你打的字不會不見。',
  },
];

const injectDemo: Demo = {
  id: 'inject',
  title: '先跑指令，再把結果交給 Claude',
  skill: `---
name: commit-check
description: Review staged changes before committing
---

## 目前狀態
- 分支：!\`git branch --show-current\`
- 已暫存的檔案：

\`\`\`!
git diff --cached --stat
\`\`\`

## 你的任務
檢查上面的變更有沒有不該提交的檔案。`,
  input: '/commit-check',
  result: `## 目前狀態
- 分支：⟦feature/login⟧
- 已暫存的檔案：

⟦ src/auth.ts  | 12 ++++++----
 .env.local   |  2 ++
 2 files changed, 10 insertions(+), 4 deletions(-)⟧

## 你的任務
檢查上面的變更有沒有不該提交的檔案。`,
  note: 'Claude 看不到 !`…` 這些指令本身，只看到執行結果。所以它一開始就知道 .env.local 被暫存了。',
};

const sources = [
  { title: 'Extend Claude with skills（Claude Code 文件）', href: 'https://code.claude.com/docs/en/skills' },
  { title: 'Skill authoring best practices（Claude Platform 文件）', href: 'https://platform.claude.com/docs/en/agents-and-tools/agent-skills/best-practices' },
];

const examples = [
  {
    id: 'workflow',
    tab: '工作流程',
    sub: '自動觸發',
    path: '.claude/skills/writing-commits/SKILL.md',
    note: '讀取暫存的 diff，用專案的 Conventional Commits 格式寫 commit message。allowed-tools 讓它讀 git 不必每次詢問。',
    code: `---
name: writing-commits
description: Writes commit messages in this repo's Conventional Commits style by reading the staged diff. Use when the user asks for a commit message, wants to commit, or says 幫我寫 commit.
allowed-tools: Bash(git diff *) Bash(git status *)
---

## Staged changes
!\`git diff --cached\`

## Rules
- Format: <type>(<scope>): <summary>, summary ≤ 72 chars, imperative mood
- type is one of: feat, fix, docs, refactor, test, chore
- Body explains WHY, not what; wrap at 72 chars
- If the diff mixes unrelated changes, suggest splitting before writing

## Example
Input: added retry to fetchUser, plus a test
Output: feat(api): retry fetchUser on transient 5xx errors

## If nothing is staged
Say so and show \`git status\`; do not invent a message.`,
  },
  {
    id: 'task',
    tab: '任務',
    sub: '手動、fork',
    path: '.claude/skills/audit-deps/SKILL.md',
    note: '只能用 /audit-deps 手動啟動，在 subagent 裡跑完再回報，不會塞滿主對話。',
    code: `---
name: audit-deps
description: Audits project dependencies for outdated or vulnerable packages and returns a prioritized upgrade list.
disable-model-invocation: true
context: fork
agent: general-purpose
argument-hint: [package-dir]
---

Audit the dependencies in $ARGUMENTS (default: repo root).

1. Detect the package manager from the lockfile.
2. Run its outdated and audit commands.
3. For each finding, note current → latest version and whether it is a major bump.
4. Return a table: package | current | latest | severity | breaking? | recommendation.
   Put security issues first, then major bumps.

Do not modify any files. If no lockfile is found, report that and stop.`,
  },
  {
    id: 'reference',
    tab: '參考',
    sub: '搭配附加檔案',
    path: '.claude/skills/api-conventions/SKILL.md',
    note: '本體只放最常用的三條規則，細節放在附加檔案；paths 讓它只在處理 API 程式碼時觸發。',
    code: `---
name: api-conventions
description: REST API design conventions for this codebase (naming, error format, pagination, versioning). Use when creating or reviewing API endpoints, routes, or controllers.
paths: src/api/**
---

- Plural nouns for resources: /users, /orders/{id}
- Errors always return { "error": { "code", "message" } } with the right HTTP status
- List endpoints use cursor pagination (?cursor=&limit=, max 100)

For the full error code table, read [errors.md](errors.md).
For pagination edge cases, read [pagination.md](pagination.md).`,
  },
];

const treeCode = `pdf-processing/
├── SKILL.md          # 概要與導覽（必要）
├── reference.md      # 詳細 API，需要時才讀
├── examples.md       # 範例集，需要時才讀
└── scripts/
    └── fill_form.py  # 直接執行，不載入內容`;

const navCode = `## Additional resources
- 表單欄位對照與完整 API：見 [reference.md](reference.md)
- 填表範例：見 [examples.md](examples.md)
- 填表請執行 python scripts/fill_form.py in.pdf fields.json
  （不要自己重寫邏輯）`;

const checklist = [
  'description 同時寫了「做什麼」與「何時用」，且用第三人稱',
  '用「應觸發」與「不應觸發」的提示各測過一次',
  'SKILL.md 本體少於 500 行，最重要的規則在最上面',
  '附加檔案只做一層參照，且每個都寫明何時讀',
  '有副作用的 skill 設了 disable-model-invocation: true',
  '腳本自己處理錯誤，並列出依賴套件',
  '用詞一致，沒有會過期的資訊',
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'TechArticle',
    '@id': `${url}#guide`,
    url,
    headline: 'Skills 撰寫指南',
    description: unit.description,
    inLanguage: 'zh-Hant-TW',
    datePublished: published.toISOString(),
    isPartOf: { '@id': `${home}#website` },
    author: { '@type': 'Person', name: AUTHORS.claude.name, url: AUTHORS.claude.sameAs[0] },
    citation: sources.map((s) => s.href),
    hasPart: chapters.map((c) => ({ '@type': 'WebPageElement', name: c.title, url: `${url}#${c.id}` })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: '首頁', item: home },
      { '@type': 'ListItem', position: 2, name: `${unit.title} 專題`, item: url },
    ],
  },
];
---
<BaseLayout
  title={`Skills 撰寫指南｜${unit.title} 專題`}
  description={unit.description}
  type="article"
  publishedTime={published}
  authorNames={AUTHORS.claude.name}
  jsonLd={jsonLd}
>
  <div class="cs" data-cs-app>
    <header class="cs-hero">
      <div class="cs-hero-text">
        <p class="cs-eyebrow">專題單元 / CLAUDE SKILLS</p>
        <h1>Skills 撰寫指南<span class="accent" aria-hidden="true">.</span></h1>
        <p class="cs-lead">一個 skill 就是一個資料夾加一份 <code>SKILL.md</code>。上半部的 frontmatter 決定 Claude 什麼時候想到它，下半部的內容決定它想到之後做得好不好。</p>
        <p class="meta">作者：{AUTHORS.claude.name} · 依官方文件整理 · <time datetime="2026-11-17">2026-11-17</time></p>
        <!-- 欄位快搜：需要 JavaScript，沒有時保持隱藏；捲過 hero 後固定在視窗頂端、滿寬 -->
        <div class="cs-search-slot" data-cs-search-slot hidden>
          <div class="cs-search" data-cs-search>
            <div class="cs-search-inner">
              <label class="cs-search-box">
                <span class="visually-hidden">搜尋 Frontmatter 欄位</span>
                <svg class="cs-search-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" fill="none" stroke="currentColor" stroke-width="2.5"/><path d="M15.5 15.5 21 21" stroke="currentColor" stroke-width="2.5" stroke-linecap="square"/></svg>
                <input
                  id="cs-search-input" type="text" role="combobox" autocomplete="off" spellcheck="false"
                  aria-autocomplete="list" aria-expanded="false" aria-controls="cs-search-list" aria-describedby="cs-search-hint"
                  placeholder="搜尋 frontmatter 欄位…" data-cs-search-input
                />
                <kbd class="cs-kbd" aria-hidden="true" data-cs-search-kbd>Ctrl F</kbd>
              </label>
              <p id="cs-search-hint" class="visually-hidden">快速鍵 Ctrl+F。用上下方向鍵選擇，Enter 跳到欄位說明，Esc 關閉。</p>
              <ul id="cs-search-list" class="cs-search-list" role="listbox" aria-label="符合的欄位" data-cs-search-list hidden></ul>
            </div>
          </div>
        </div>
        <script type="application/json" data-cs-search-data set:html={JSON.stringify(searchIndex).replace(/</g, '\\u003c')}></script>
      </div>
      <figure class="cs-anatomy">
        <figcaption class="cs-anatomy-bar">.claude/skills/writing-commits/SKILL.md</figcaption>
        <div class="cs-zone cs-z1">
          <p class="cs-zone-tag">第 1 層・永遠在 context</p>
          <pre><span class="c">---</span>
<span class="k">name</span>: writing-commits
<span class="k">description</span>: <span class="s">Writes commit messages from</span>
  <span class="s">the staged diff. Use when the user</span>
  <span class="s">asks for a commit message.</span>
<span class="c">---</span></pre>
        </div>
        <div class="cs-zone cs-z2">
          <p class="cs-zone-tag">第 2 層・觸發後載入</p>
          <pre><span class="k">## Rules</span>
- Format: type(scope): summary
- Body explains WHY, not what
<span class="k">## Staged changes</span>
!`git diff --cached`</pre>
        </div>
        <div class="cs-zone cs-z3">
          <p class="cs-zone-tag">第 3 層・需要時才讀</p>
          <pre><span class="c">For the full type list, read</span>
[reference.md](reference.md)
<span class="c">Validate with</span> scripts/lint_msg.py</pre>
        </div>
      </figure>
    </header>

    <div class="cs-layout" data-cs-layout>
      <nav class="cs-nav" aria-label="指南章節">
        <ol>
          {chapters.map((c, i) => (
            <li><a href={`#${c.id}`} data-cs-link={c.id}><span class="num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>{c.title}</a></li>
          ))}
        </ol>
      </nav>

      <div class="cs-views">
        <!-- 01 -->
        <section id="load" class="cs-view" aria-labelledby="load-title" data-cs-view>
          <p class="cs-kicker">01 · 漸進式揭露</p>
          <h2 id="load-title" tabindex="-1">Skill 怎麼被載入</h2>
          <p class="cs-intro">內容分三層，只有用得到的那層才會進到 context。寫 skill 時，每一段文字都該想清楚它屬於哪一層。</p>
          <ol class="cs-layers">
            <li>
              <span class="cs-when">啟動時</span>
              <div><h3>Metadata：name 與 description</h3><p>所有 skill 的描述一開始就放進 context，Claude 只靠這段決定要不要用它。</p></div>
              <span class="cs-cost">每個 skill 都付</span>
            </li>
            <li>
              <span class="cs-when">觸發時</span>
              <div><h3>SKILL.md 本體</h3><p>被呼叫後整份載入，並留在對話裡跨回合存在。每一行都是持續性的 token 成本。</p></div>
              <span class="cs-cost">建議少於 500 行</span>
            </li>
            <li>
              <span class="cs-when">需要時</span>
              <div><h3>附加檔案與 scripts</h3><p>Claude 依 SKILL.md 的指引才去讀參考檔或執行腳本；腳本只有輸出會進 context。</p></div>
              <span class="cs-cost">用到才付</span>
            </li>
          </ol>
          <h3>存放位置（Claude Code）</h3>
          <div class="cs-table" role="region" aria-label="存放位置" tabindex="0">
            <table>
              <thead><tr><th scope="col">範圍</th><th scope="col">路徑</th><th scope="col">適用</th></tr></thead>
              <tbody>
                <tr><th scope="row">個人</th><td><code>~/.claude/skills/&lt;name&gt;/SKILL.md</code></td><td>本機所有專案</td></tr>
                <tr><th scope="row">專案</th><td><code>.claude/skills/&lt;name&gt;/SKILL.md</code></td><td>此 repo，commit 後團隊共用</td></tr>
                <tr><th scope="row">Plugin</th><td><code>&lt;plugin&gt;/skills/&lt;name&gt;/SKILL.md</code></td><td>以 <code>/plugin-name:skill-name</code> 呼叫</td></tr>
                <tr><th scope="row">claude.ai 帳號</th><td>上傳到 claude.ai 的 skill</td><td>Cowork、雲端，以及登入同帳號的終端機</td></tr>
              </tbody>
            </table>
          </div>
          <p>資料夾不要命名為 <code>synced</code> 或 <code>anthropic-skills</code>，這兩個是保留名稱，會被略過。</p>
          <Fragment set:html={pagerHtml(pager('load'))} />
        </section>

