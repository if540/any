---
// 文章與日誌共用的內頁版型：TL;DR、日期、FAQ、BlogPosting/Breadcrumb/FAQPage JSON-LD
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import BaseLayout from './BaseLayout.astro';
import { SITE, AUTHOR } from '../consts';
import { absoluteUrl, withBase } from '../utils/url';
import { formatDate } from '../utils/content';

export interface Props {
  kind: 'articles' | 'journal';
  title: string;
  description: string;
  published: Date;
  updated?: Date;
  tags?: string[];
  cover?: ImageMetadata;
  coverAlt?: string;
  ogImage?: string;
  tldr?: string;
  faq?: { question: string; answer: string }[];
  mood?: string;
  canonical?: string;
  noindex?: boolean;
}

const p = Astro.props;
const section = p.kind === 'articles'
  ? { label: '文章', href: '/articles/' }
  : { label: '日誌', href: '/journal/' };

const url = absoluteUrl(Astro.url.pathname, Astro.site);
const home = absoluteUrl('/', Astro.site);
const image = p.ogImage ?? p.cover?.src ?? SITE.defaultOgImage;

const jsonLd: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    '@id': `${url}#post`,
    headline: p.title,
    description: p.description,
    url,
    mainEntityOfPage: url,
    datePublished: p.published.toISOString(),
    dateModified: (p.updated ?? p.published).toISOString(),
    inLanguage: SITE.lang,
    image: absoluteUrl(image, Astro.site),
    keywords: p.tags?.join(', '),
    author: { '@type': 'Person', '@id': `${home}#author`, name: AUTHOR.name },
    publisher: { '@id': `${home}#author` },
    isPartOf: { '@id': `${home}#website` },
    ...(p.tldr ? { abstract: p.tldr } : {}),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: '首頁', item: home },
      { '@type': 'ListItem', position: 2, name: section.label, item: absoluteUrl(section.href, Astro.site) },
      { '@type': 'ListItem', position: 3, name: p.title, item: url },
    ],
  },
];

if (p.faq?.length) {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: p.faq.map((f) => ({
      '@type': 'Question',
      name: f.question,
      acceptedAnswer: { '@type': 'Answer', text: f.answer },
    })),
  });
}
---
<BaseLayout
  title={p.title}
  description={p.description}
  image={image}
  imageAlt={p.coverAlt ?? p.title}
  type="article"
  publishedTime={p.published}
  modifiedTime={p.updated}
  tags={p.tags}
  canonical={p.canonical}
  noindex={p.noindex}
  jsonLd={jsonLd}
>
  <article class="post">
    <nav class="crumbs meta" aria-label="麵包屑">
      <a href={withBase('/')}>首頁</a> / <a href={withBase(section.href)}>{section.label}</a>
    </nav>

    <header class="post-head">
      <h1>{p.title}</h1>
      <p class="meta">
        <time datetime={p.published.toISOString()}>發布 {formatDate(p.published)}</time>
        {p.updated && (
          <> · <time datetime={p.updated.toISOString()}>更新 {formatDate(p.updated)}</time></>
        )}
        {p.mood && <> · 心情 {p.mood}</>}
        {' · '}作者 <a href={withBase('/about/')} rel="author">{AUTHOR.name}</a>
      </p>
      {p.tags && p.tags.length > 0 && (
        <p class="tags">{p.tags.map((t) => <span class="tag">{t}</span>)}</p>
      )}
    </header>

    {p.cover && (
      <Image class="cover" src={p.cover} alt={p.coverAlt ?? ''} widths={[640, 960, 1280]} sizes="(min-width: 68rem) 68rem, 100vw" loading="eager" />
    )}

    {p.tldr && (
      <aside class="tldr" aria-label="重點摘要">
        <strong>TL;DR</strong>
        <p>{p.tldr}</p>
      </aside>
    )}

    <div class="prose">
      <slot />
    </div>

    {p.faq && p.faq.length > 0 && (
      <section class="faq prose" aria-labelledby="faq-title">
        <h2 id="faq-title">常見問題</h2>
        {p.faq.map((f) => (
          <details>
            <summary>{f.question}</summary>
            <p>{f.answer}</p>
          </details>
        ))}
      </section>
    )}

    <p class="back"><a href={withBase(section.href)}>← 回到{section.label}列表</a></p>
  </article>
</BaseLayout>

<style>
  .crumbs { margin-bottom: 1rem; }
  .crumbs a { color: var(--muted); }
  .post-head { max-width: var(--measure); margin-bottom: 2rem; }
  .post-head h1 { margin-bottom: 0.75rem; }
  .post-head .meta { margin: 0 0 0.5rem; }
  .tags { margin: 0; }
  .cover { width: 100%; margin-bottom: 2.5rem; border: 3px solid var(--line); }
  .tldr {
    max-width: var(--measure); margin: 0 0 2.5rem; padding: 1rem 1.25rem;
    background: var(--orange); color: var(--black); border: 3px solid var(--black);
    box-shadow: 6px 6px 0 var(--black);
  }
  @media (prefers-color-scheme: dark) { .tldr { box-shadow: 6px 6px 0 var(--white); } }
  .tldr strong { font-family: var(--font-mono); font-size: 0.85rem; letter-spacing: 0.08em; }
  .tldr p { margin: 0.25rem 0 0; font-weight: 700; }
  .faq { margin-top: 4rem; }
  details { border-top: 2px solid var(--line); padding: 0.75rem 0; }
  details:last-of-type { border-bottom: 2px solid var(--line); }
  summary { cursor: pointer; font-weight: 700; list-style: none; display: flex; justify-content: space-between; gap: 1rem; }
  summary::after { content: '+'; color: var(--orange); font-weight: 900; font-size: 1.3rem; line-height: 1; }
  details[open] summary::after { content: '−'; }
  summary::-webkit-details-marker { display: none; }
  details p { margin: 0.75rem 0 0; }
  .back { margin-top: 4rem; font-weight: 700; }
</style>
